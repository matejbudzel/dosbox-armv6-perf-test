[sdl]
fullscreen=true
fulldouble=false
output=surface

[dosbox]
machine=ega
memsize=8

[cpu]
core=normal
cputype=386
cycles=@CYCLES@

[mixer]
nosound=false
rate=22050
blocksize=2048
prebuffer=100

[speaker]
pcspeaker=true
pcrate=22050

[sblaster]
sbtype=sbpro1
sbbase=220
irq=7
dma=1
hdma=5

[autoexec]
mount c "@GAMEDIR@"
c:
GPEGA.EXE
