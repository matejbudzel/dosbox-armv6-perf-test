[sdl]
fullscreen=true
fulldouble=false
output=surface

[dosbox]
machine=svga_s3
memsize=16

[cpu]
core=dynamic
cputype=386
cycles=max

[mixer]
nosound=false
rate=22050
blocksize=512
prebuffer=20

[speaker]
pcspeaker=true
pcrate=22050

[sblaster]
sbtype=sbpro1
sbbase=220
irq=7
dma=1
hdma=5

[autoexec]
mount c "@GAMEDIR@"
c:
GP.EXE
